---
import BaseLayout from '../layouts/BaseLayout.astro';
import LostScene from '../components/LostScene.astro';
import { href } from '../lib/utils';
---

<BaseLayout title="Page not found" description="That page doesn't exist.">
  <section class="lost">
    <div class="lost__art"><LostScene /></div>

    <div class="lost__text">
      <p class="lost__code">404</p>
      <h1 class="lost__title">Looks like you're off the map.</h1>
      <p class="lost__body">
        The content you're looking for<br />
        doesn't exist, has been moved,<br />
        or got lost somewhere in the internet.
      </p>
      <p><a class="lost__button" href={href('/')}>← Back to blog</a></p>
    </div>
  </section>
</BaseLayout>
