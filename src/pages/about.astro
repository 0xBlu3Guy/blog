---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config';
import { href } from '../lib/utils';

/**
 * To change the photo, replace public/about-portrait.jpg and update the
 * width/height below to match the new file. It's shown blurred on purpose.
 */
const portrait = href('/about-portrait.jpg');

const work = [
  'Web and API security — access control, auth flows, logic bugs',
  'Bug bounty — repeatable recon, notes that survive the week',
  'CTFs — Jeopardy format, mostly web and forensics',
  'Detection and infrastructure — Linux, logs, and noticing things',
];
---

<BaseLayout
  title="About"
  description={site.description}
>
  <div class="about">
    <h1 class="page-title">About</h1>

    <div class="about__grid">
      <figure class="portrait">
        <span class="portrait__frame">
          <img
            class="portrait__img"
            src={portrait}
            width="320"
            height="640"
            alt="Portrait of Sobhan, deliberately obscured"
            loading="eager"
            decoding="async"
          />
          <span class="portrait__grain" aria-hidden="true"></span>
        </span>
      </figure>

      <div class="about__text">
        <p class="about__lead">
          I'm Sobhan. I break things carefully, then write down what I learned
          so the next person — usually future me — doesn't have to rediscover it.
        </p>

        <p>
          Most of what I do is web and API security: reading an application
          until it makes sense, then looking for the place where the story it
          tells and the thing it does disagree. The tools confirm. They don't
          discover.
        </p>

        <h2 class="about__h">What I work on</h2>
        <ul class="about__list">
          {work.map((w) => <li>{w}</li>)}
        </ul>

        <h2 class="about__h">Why this blog</h2>
        <p>
          Published notes beat private ones. A private note lets you stay
          vague; writing for a stranger is how I find out whether I actually
          understood it.
        </p>

        <h2 class="about__h">Privacy</h2>
        <p>
          This site sets no cookies and runs no analytics or tracking of any
          kind, and every page is served from this site alone, with no fonts,
          scripts or embeds pulled from anywhere else. I don't know who visits,
          when, or how many times a post has been read.
        </p>
        <p>
          Nothing is stored in your browser either. The
          <a href={href('/privacy')}>privacy page</a> has the details, and how
          to check them yourself.
        </p>

        <h2 class="about__h">Elsewhere</h2>
        <p class="about__links">
          <a href={site.social.github} rel="noopener noreferrer" target="_blank">GitHub</a>
          {site.social.linkedin && (
            <>
              <span aria-hidden="true"> · </span>
              <a href={site.social.linkedin} rel="noopener noreferrer" target="_blank">LinkedIn</a>
            </>
          )}
          <span aria-hidden="true"> · </span>
          <a href={href('/rss.xml')}>RSS</a>
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
