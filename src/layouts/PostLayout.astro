---
import type { Post } from '../lib/posts';
import BaseLayout from './BaseLayout.astro';
import PostMeta from '../components/PostMeta.astro';
import Tag from '../components/Tag.astro';
import { excerpt, href, readingTime } from '../lib/utils';
import { Image } from 'astro:assets';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, date, tags, image, imageAlt } = post.data;
const summary = description || excerpt(post.body ?? '');
const minutes = readingTime(post.body ?? '');
---

<BaseLayout
  title={title}
  description={summary}
  image={image?.src ?? href(`/og/${post.id}.png`)}
  publishedDate={date}
  tags={[...tags]}
>
  <article class="article">
    <a class="back-link" href={href('/')}>← Back to posts</a>

    <header class="article__header">
      <h1 class="article__title">{title}</h1>
      <div class="article__meta">
        <PostMeta date={date} minutes={minutes} />
      </div>
      {tags.length > 0 && (
        <ul class="tag-list">
          {tags.map((tag) => (
            <li><Tag name={tag} /></li>
          ))}
        </ul>
      )}
    </header>

    {image && (
      <Image class="article__hero" src={image} alt={imageAlt ?? ''} widths={[720, 1440]} />
    )}

    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<script>
  // Wrap each code block so a copy button can be positioned over it.
  const COPIED_MS = 1600;

  // Terminal blocks copy their commands only: the prompts are drawn by CSS and
  // output lines are skipped.
  function copyText(pre: HTMLPreElement): string {
    if (!pre.classList.contains('is-terminal')) return pre.innerText;
    return [...pre.querySelectorAll('.line--cmd, .line--cont')]
      .map((line) => line.textContent ?? '')
      .join('\n');
  }

  document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
    const wrapper = document.createElement('div');
    wrapper.className = 'code-block';
    pre.parentNode?.insertBefore(wrapper, pre);
    wrapper.appendChild(pre);

    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'copy-button';
    button.textContent = 'Copy';
    button.setAttribute('aria-label', 'Copy code to clipboard');

    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(copyText(pre));
        button.textContent = 'Copied';
      } catch {
        button.textContent = 'Failed';
      }
      button.dataset.copied = 'true';
      setTimeout(() => {
        button.textContent = 'Copy';
        delete button.dataset.copied;
      }, COPIED_MS);
    });

    wrapper.appendChild(button);
  });

  // Click a screenshot to see it full size. Only images that are shown smaller
  // than their real size are zoomable.
  const lightbox = document.createElement('dialog');
  lightbox.className = 'lightbox';
  lightbox.setAttribute('aria-label', 'Enlarged image');
  const lightboxImg = document.createElement('img');
  lightbox.appendChild(lightboxImg);
  lightbox.addEventListener('click', () => lightbox.close());
  document.body.appendChild(lightbox);

  function open(img: HTMLImageElement) {
    lightboxImg.src = img.currentSrc || img.src;
    lightboxImg.alt = img.alt;
    lightbox.showModal();
  }

  document.querySelectorAll<HTMLImageElement>('.prose img').forEach((img) => {
    if (img.closest('a')) return;

    const enable = () => {
      if (img.naturalWidth <= img.clientWidth) return;
      img.classList.add('is-zoomable');
      img.tabIndex = 0;
      img.setAttribute('role', 'button');
      img.setAttribute('aria-label', `Enlarge image: ${img.alt}`);
    };
    if (img.complete) enable();
    else img.addEventListener('load', enable, { once: true });

    img.addEventListener('click', () => {
      if (img.classList.contains('is-zoomable')) open(img);
    });
    img.addEventListener('keydown', (event) => {
      if (!img.classList.contains('is-zoomable')) return;
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        open(img);
      }
    });
  });
</script>
