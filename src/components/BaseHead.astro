---
import { site } from '../site.config';
import { href } from '../lib/utils';

interface Props {
  title: string;
  description?: string;
  /**
   * Absolute or site-relative URL of a wide social preview image — a post's
   * own `image`, or its generated /og/<slug>.png card. Pages without one fall
   * back to the square logo.
   */
  image?: string;
  /** Set on post pages so Open Graph reports an article. */
  publishedDate?: Date;
  tags?: string[];
}

const { title, description, image, publishedDate, tags } = Astro.props;

const pageTitle = title === site.title ? title : `${title} · ${site.title}`;
const pageDescription = description || site.description;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site);
// A post's own image gets a large card; the logo fallback is square, so it
// gets the small one.
const ownImage = image ? new URL(image, Astro.site).href : undefined;
const imageUrl = ownImage ?? new URL(href('/icon-512.png'), Astro.site).href;
const articleTags = tags ?? [];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={pageDescription} />
<meta name="author" content={site.author} />
<link rel="canonical" href={canonical.href} />

<link rel="icon" href={href('/favicon.ico')} sizes="any" />
<link rel="icon" href={href('/favicon-32.png')} type="image/png" sizes="32x32" />
<link rel="icon" href={href('/favicon-16.png')} type="image/png" sizes="16x16" />
<link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
<link
  rel="alternate"
  type="application/rss+xml"
  title={site.title}
  href={new URL(href('/rss.xml'), Astro.site).href}
/>
<link rel="sitemap" href={href('/sitemap-index.xml')} />

<!-- Open Graph -->
<meta property="og:type" content={publishedDate ? 'article' : 'website'} />
<meta property="og:site_name" content={site.title} />
<meta property="og:title" content={title} />
<meta property="og:description" content={pageDescription} />
<meta property="og:url" content={canonical.href} />
{imageUrl && <meta property="og:image" content={imageUrl} />}
{publishedDate && (
  <meta property="article:published_time" content={publishedDate.toISOString()} />
)}
{articleTags.map((tag) => (
  <meta property="article:tag" content={tag} />
))}

<!-- Twitter/X card -->
<meta name="twitter:card" content={ownImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={pageDescription} />
{imageUrl && <meta name="twitter:image" content={imageUrl} />}
